# Copy to .env.local and fill in real values. This file is safe to commit.

# --- Google OAuth (required) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Frontend origin (required in dev) ---
FRONTEND_URL=http://localhost:7173

# --- Storage backend ---
# STORAGE_MODE=local  -> profile pics + receipts under STORAGE_LOCAL_ROOT (default ./data/blobs)
# STORAGE_MODE=s3     -> uses the AWS_S3_* values below
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=./data

# --- AWS S3 (used only when STORAGE_MODE=s3) ---
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# Optional: overrides for LocalStack / MinIO / a subfolder in the bucket
AWS_S3_ENDPOINT=
AWS_S3_PREFIX=

# --- DynamoDB (defaults are fine for local dev) ---
# DYNAMODB_ENDPOINT=http://localhost:8000
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local

# --- Seed data (local dev) ---
# Loads the sample groups on startup, owned by this account.
SEED_ENABLED=true
SEED_OWNER_EMAIL=you@gmail.com
SEED_OWNER_NAME="Your Name"
